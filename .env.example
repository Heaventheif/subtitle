# سرّ مشترك بين التطبيق والخادم (يُرسل في الترويسة X-App-Token). اتركه فارغاً لتعطيل الفحص.
APP_TOKEN=change-me

# TMDB (مجاني): لتحويل اسم الملف إلى معرّف. إما مفتاح v3 أو رمز v4 (يبدأ بـ eyJ)
TMDB_API_KEY=

# الطبقة 1: مفاتيح مفصولة بفواصل (مفاتيح تملكها أنت فعلاً)
WYZIE_KEYS=
WYZIE_DAILY_LIMIT=1000

# حسابات OpenSubtitles (قائمة JSON). التنزيل يحتاج تسجيل دخول لكل حساب
# [{"api_key":"...","username":"...","password":"..."}]
OPENSUBTITLES_ACCOUNTS=
OPENSUBTITLES_DAILY_LIMIT=200

# الطبقة 2
SUBDL_API_KEYS=
SUBDL_DAILY_LIMIT=500
ENABLE_SCRAPING=0
FIRECRAWL_KEYS=
# أو الاسم البديل
# FIRECRUL_API=key1,key2,key3

# ── الذكاء الاصطناعي (مفاتيح متعددة مفصولة بفواصل — تدوير تلقائي) ──
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEYS=key1,key2,key3
GEMINI_DAILY_LIMIT=1500
# اختياري: تجاوز النموذج (يمكن قائمة مفصولة بفواصل؛ تُجرَّب بالترتيب عند 404)
# GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEYS=gsk_xxx1,gsk_xxx2
GROQ_DAILY_LIMIT=1000
# اختياري: llama-3.3-70b-versatile أُوقف في 2026-08-16
# GROQ_MODEL=openai/gpt-oss-120b

# تفعيل/تعطيل ميزات AI
ENABLE_AI_TRANSLATE=1
ENABLE_AI_TITLE_CLEAN=1

# إبقاء الخادم مستيقظاً (Render): يُملأ تلقائياً من RENDER_EXTERNAL_URL. محلياً اتركه فارغاً.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL=600

# التخزين
DB_PATH=data/cache.db
# مدة كاش نتائج البحث بالساعات (افتراضي 720 = 30 يوماً)
SEARCH_CACHE_HOURS=720
