# ─── سرّ مشترك مع التطبيق (ترويسة X-App-Token). فارغ = بلا فحص ───
APP_TOKEN=change-me

# ─── OpenSubtitles: حسابات (قائمة JSON) ───
# البحث بمفتاح API والتنزيل يحتاج تسجيل دخول الحساب
# [{"api_key":"...","username":"...","password":"..."}]
OPENSUBTITLES_ACCOUNTS=
OPENSUBTITLES_DAILY_LIMIT=200

# ─── SubDL (مفاتيح مفصولة بفواصل) ───
SUBDL_API_KEYS=
SUBDL_DAILY_LIMIT=500

# ─── السرعة ───
# مهلة البحث الكلي (المزوّدان بالتوازي): الرد الجزئي أفضل من الرد البطيء
SEARCH_TIMEOUT_MS=6000
# مهلة تنزيل ملف الترجمة
REQUEST_TIMEOUT_MS=15000
# كاش نتائج البحث (ساعات) — افتراضي 720 = 30 يوماً
CACHE_TTL_HOURS=720
# كاش سلبي للنتائج الفارغة (ساعات) — يمنع ضرب المزوّدين مراراً بلا فائدة
NEG_CACHE_TTL_HOURS=3
# حد الطلبات لكل IP في الدقيقة (429 عند التجاوز)
RATE_LIMIT_PER_MIN=60

# ─── التخزين ───
DB_PATH=data/cache.db

# ─── إبقاء الخادم مستيقظاً على Render المجاني ───
# يُملأ تلقائياً من RENDER_EXTERNAL_URL عند النشر. محلياً اتركه فارغاً.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=600000

# اختياري: بديل USER_AGENT
# USER_AGENT=SubtitleServer/3.0-go
